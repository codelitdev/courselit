      }
    ],
    "ctaLabel": "Start free trial",
    "ctaHref": "https://app.courselit.app"
  },
  "footer": {
    "layout": "columns",
    "tagline": "The open-source platform for courses, downloads and communities.",
    "columns": [
      {
