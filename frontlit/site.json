          },
          {
            "label": "Changelog",
            "href": "/changelog"
          },
          {
            "label": "Open source",
            "href": "/open-source"
          }
        ]
      },
      {
        "title": "Features",
        "links": [
          {
            "label": "Courses",
            "href": "/courses"
          },
          {
            "label": "Communities",
            "href": "/communities"
          },
          {
            "label": "Email marketing",
            "href": "/email-marketing"
          },
          {
            "label": "Payments",
            "href": "/payments"
          }
        ]
      },
      {
        "title": "Resources",
        "links": [
          {
            "label": "Docs",
            "href": "/docs"
          },
          {
            "label": "Developers",
            "href": "/developers"
          },
          {
            "label": "Blog",
            "href": "/blog"
          },
          {
            "label": "Help",
            "href": "/help"
          },
          {
            "label": "Discord",
            "href": "https://discord.com/invite/GR4bQsN"
          },
          {
            "label": "YouTube",
            "href": "https://www.youtube.com/channel/UCy0zj-_sCgLL_zN_oVDRVpw"
          }
        ]
      },
      {
        "title": "Company",
        "links": [
          {
            "label": "About",
            "href": "/about"
          },
          {
            "label": "Contact",
            "href": "/help"
          },
          {
            "label": "Terms of use",
            "href": "/terms"
          },
          {
            "label": "Privacy policy",
            "href": "/privacy"
          },
          {
            "label": "Refund policy",
            "href": "/refund-policy"
          }
        ]
      }
    ],
    "copyrightText": "© 2026 CourseLit. All rights reserved."
  },
  "redirects": [
    {
      "from": "/p/terms",
      "to": "/terms"
    },
    {
      "from": "/p/privacy",
      "to": "/privacy"
    },
    {
      "from": "/p/refund-policy",
      "to": "/refund-policy"
    },
    {
      "from": "/p/courselit-vs-teachable",
      "to": "/features",
      "permanent": false
    },
    {
      "from": "/p/courselit-vs-thinkific",
      "to": "/features",
      "permanent": false
    },
    {
      "from": "/demo",
      "to": "https://demo.courselit.app",
      "permanent": false
    }
  ]
}
