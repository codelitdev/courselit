{
  "$schema": "https://frontlit.app/schema/site.v1.json",
  "theme": {
    "colors": {
      "light": {
        "background": "#f9f6f2",
        "foreground": "#261d16",
        "card": "#fefdfb",
        "cardForeground": "#261d16",
        "popover": "#fefdfb",
        "popoverForeground": "#261d16",
        "primary": "#b54c3d",
        "primaryForeground": "#fdfcf8",
        "secondary": "#eeebe5",
        "secondaryForeground": "#352c25",
        "muted": "#eeebe5",
        "mutedForeground": "#5c544b",
        "accent": "#f3e4df",
        "accentForeground": "#352c25",
        "destructive": "#c13c36",
        "border": "#e2ddd5",
        "input": "#d8d3cc",
        "ring": "#c65b4c",
        "chart1": "#c65b4c",
        "chart2": "#cf7b26",
        "chart3": "#2d8949",
        "chart4": "#8e6ac7",
        "chart5": "#6a6258",
        "sidebar": "#f9f6f2",
        "sidebarForeground": "#261d16",
        "sidebarPrimary": "#b54c3d",
        "sidebarPrimaryForeground": "#fdfcf8",
        "sidebarAccent": "#eeebe5",
        "sidebarAccentForeground": "#352c25",
        "sidebarBorder": "#e2ddd5",
        "sidebarRing": "#c65b4c",
        "shadow2xs": "0 1px 2px 0 rgb(38 29 22 / 0.04)",
        "shadowXs": "0 1px 2px 0 rgb(38 29 22 / 0.05)",
        "shadowSm": "0 1px 2px 0 rgb(38 29 22 / 0.05), 0 1px 3px -1px rgb(38 29 22 / 0.08)",
        "shadowMd": "0 2px 4px -1px rgb(38 29 22 / 0.06), 0 4px 8px -2px rgb(38 29 22 / 0.08)",
        "shadowLg": "0 8px 16px -4px rgb(38 29 22 / 0.08), 0 4px 6px -2px rgb(38 29 22 / 0.04)",
        "shadowXl": "0 16px 32px -8px rgb(38 29 22 / 0.12)",
        "shadow2xl": "0 24px 48px -12px rgb(38 29 22 / 0.18)"
      },
      "dark": {
        "background": "#1b1510",
        "foreground": "#ebe7e2",
        "card": "#251e18",
        "cardForeground": "#ebe7e2",
        "popover": "#2a221d",
        "popoverForeground": "#ebe7e2",
        "primary": "#eb8373",
        "primaryForeground": "#250e0b",
        "secondary": "#312a24",
        "secondaryForeground": "#dbd7d0",
        "muted": "#2e2721",
        "mutedForeground": "#989188",
        "accent": "#3a2722",
        "accentForeground": "#dbd7d0",
        "destructive": "#d9544b",
        "border": "#38312b",
        "input": "#433c35",
        "ring": "#eb8373",
        "chart1": "#eb8373",
        "chart2": "#e6a05c",
        "chart3": "#5fb37a",
        "chart4": "#b191ea",
        "chart5": "#989188",
        "sidebar": "#251e18",
        "sidebarForeground": "#ebe7e2",
        "sidebarPrimary": "#eb8373",
        "sidebarPrimaryForeground": "#250e0b",
        "sidebarAccent": "#312a24",
        "sidebarAccentForeground": "#dbd7d0",
        "sidebarBorder": "#38312b",
        "sidebarRing": "#eb8373",
        "shadow2xs": "0 1px 2px 0 rgb(0 0 0 / 0.24)",
        "shadowXs": "0 1px 2px 0 rgb(0 0 0 / 0.28)",
        "shadowSm": "0 1px 2px 0 rgb(0 0 0 / 0.32), 0 1px 3px -1px rgb(0 0 0 / 0.4)",
        "shadowMd": "0 4px 8px -2px rgb(0 0 0 / 0.4), 0 2px 4px -1px rgb(0 0 0 / 0.28)",
        "shadowLg": "0 12px 24px -6px rgb(0 0 0 / 0.5)",
        "shadowXl": "0 20px 40px -8px rgb(0 0 0 / 0.55)",
        "shadow2xl": "0 32px 64px -12px rgb(0 0 0 / 0.65)"
      }
    },
    "typography": {
      "preheader": {
        "fontFamily": "font-hanken-grotesk",
        "fontSize": "text-xs",
        "fontWeight": "font-medium",
        "lineHeight": "leading-normal",
        "letterSpacing": "tracking-widest",
        "textTransform": "uppercase"
      },
      "display": {
        "fontFamily": "font-hanken-grotesk",
        "fontSize": "text-6xl",
        "fontWeight": "font-semibold",
        "lineHeight": "leading-tight",
        "letterSpacing": "tracking-tighter",
        "fluid": {
          "min": 34,
          "max": 56
        }
      },
      "header1": {
        "fontFamily": "font-hanken-grotesk",
        "fontSize": "text-5xl",
        "fontWeight": "font-semibold",
        "lineHeight": "leading-tight",
        "letterSpacing": "tracking-tighter",
        "fluid": {
          "min": 28,
          "max": 48
        }
      },
      "header2": {
        "fontFamily": "font-hanken-grotesk",
        "fontSize": "text-4xl",
        "fontWeight": "font-semibold",
        "lineHeight": "leading-tight",
        "letterSpacing": "tracking-tight",
        "fluid": {
          "min": 24,
          "max": 36
        }
      },
      "header3": {
        "fontFamily": "font-hanken-grotesk",
        "fontSize": "text-2xl",
        "fontWeight": "font-semibold",
        "lineHeight": "leading-snug",
        "letterSpacing": "tracking-tight"
      },
      "header4": {
        "fontFamily": "font-hanken-grotesk",
        "fontSize": "text-xl",
        "fontWeight": "font-medium",
        "lineHeight": "leading-snug",
        "letterSpacing": "tracking-tight"
      },
      "subheader1": {
        "fontFamily": "font-hanken-grotesk",
        "fontSize": "text-xl",
        "fontWeight": "font-normal",
        "lineHeight": "leading-relaxed",
        "letterSpacing": "tracking-normal"
      },
      "subheader2": {
        "fontFamily": "font-hanken-grotesk",
        "fontSize": "text-lg",
        "fontWeight": "font-normal",
        "lineHeight": "leading-relaxed",
        "letterSpacing": "tracking-normal"
      },
      "text1": {
        "fontFamily": "font-hanken-grotesk",
        "fontSize": "text-base",
        "fontWeight": "font-normal",
        "lineHeight": "leading-relaxed",
        "letterSpacing": "tracking-normal"
      },
      "text2": {
        "fontFamily": "font-hanken-grotesk",
        "fontSize": "text-sm",
        "fontWeight": "font-normal",
        "lineHeight": "leading-relaxed",
        "letterSpacing": "tracking-normal"
      },
      "link": {
        "fontFamily": "font-hanken-grotesk",
        "fontSize": "text-base",
        "fontWeight": "font-medium",
        "lineHeight": "leading-relaxed",
        "letterSpacing": "tracking-normal",
        "textDecoration": "underline"
      },
      "button": {
        "fontFamily": "font-hanken-grotesk",
        "fontSize": "text-sm",
        "fontWeight": "font-medium",
        "lineHeight": "leading-normal",
        "letterSpacing": "tracking-wide"
      },
      "input": {
        "fontFamily": "font-hanken-grotesk",
        "fontSize": "text-sm",
        "fontWeight": "font-normal",
        "lineHeight": "leading-normal",
        "letterSpacing": "tracking-normal"
      },
      "caption": {
        "fontFamily": "font-hanken-grotesk",
        "fontSize": "text-xs",
        "fontWeight": "font-medium",
        "lineHeight": "leading-relaxed",
        "letterSpacing": "tracking-wide"
      },
      "code": {
        "fontFamily": "font-spline-sans-mono",
        "fontSize": "text-sm",
        "fontWeight": "font-normal",
        "lineHeight": "leading-relaxed",
        "letterSpacing": "tracking-normal"
      }
    },
    "highlight": "color",
    "interactives": {
      "button": {
        "padding": {
          "x": "px-5",
          "y": "py-3"
        },
        "border": {
          "width": "border-0",
          "radius": "rounded-xl"
        },
        "shadow": "shadow-xs",
        "custom": "transition-colors duration-200",
        "disabled": {
          "opacity": "opacity-50",
          "cursor": "cursor-not-allowed"
        }
      },
      "menu": {
        "padding": {
          "x": "px-1",
          "y": "py-1"
        },
        "border": {
          "width": "border",
          "radius": "rounded-xl",
          "style": "border-solid"
        },
        "shadow": "shadow-xs",
        "item": {
          "padding": {
            "x": "px-3",
            "y": "py-2"
          },
          "border": {
            "radius": "rounded-lg"
          }
        }
      },
      "dialog": {
        "padding": {
          "x": "px-6",
          "y": "py-6"
        },
        "border": {
          "width": "border-0",
          "radius": "rounded-xl"
        },
        "shadow": "shadow-lg"
      },
      "popover": {
        "padding": {
          "x": "px-4",
          "y": "py-4"
        },
        "border": {
          "width": "border-0",
          "radius": "rounded-xl"
        },
        "shadow": "shadow-md"
      },
      "tooltip": {
        "padding": {
          "x": "px-2",
          "y": "py-1"
        },
        "border": {
          "width": "border-0",
          "radius": "rounded-sm"
        },
        "shadow": "shadow-sm"
      },
      "link": {
        "custom": "underline-offset-4 hover:underline",
        "disabled": {
          "color": "gray-400",
          "cursor": "cursor-not-allowed"
        }
      },
      "card": {
        "padding": {
          "x": "px-6",
          "y": "py-6"
        },
        "border": {
          "width": "border",
          "radius": "rounded-2xl",
          "style": "border-solid"
        },
        "shadow": "shadow-xs",
        "custom": "transition-shadow duration-200 hover:shadow-md"
      },
      "input": {
        "padding": {
          "x": "px-4",
          "y": "py-3"
        },
        "border": {
          "width": "border",
          "radius": "rounded-xl",
          "style": "border-solid"
        },
        "shadow": "shadow-none",
        "custom": "transition-shadow duration-150 focus-visible:shadow-sm",
        "borderRadius": "rounded-xl",
        "disabled": {
          "opacity": "opacity-50",
          "cursor": "cursor-not-allowed"
        }
      }
    },
    "structure": {
      "page": {
        "width": "max-w-6xl"
      },
      "section": {
        "padding": {
          "x": "px-6",
          "y": "py-20"
        }
      }
    }
  },
  "header": {
    "links": [
      {
        "label": "Features",
        "href": "/features"
      },
      {
        "label": "Pricing",
        "href": "/pricing"
