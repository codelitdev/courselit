        "contentType": "script",
        "content": "<div class=\"cl-proof\" id=\"cl-proof\">\n<style>\n.cl-proof{--cl-fg:var(--foreground,#261d16);--cl-muted-fg:var(--muted-foreground,#5c544b);--cl-card:var(--card,#fefdfb);--cl-border:var(--border,#e2ddd5);--cl-accent:#b54c3d;color:var(--cl-fg);font:inherit;font-family:\"fl-hanken-grotesk\",\"Hanken Grotesk\",ui-sans-serif,system-ui,sans-serif;container-type:inline-size}\n:host(.dark) .cl-proof,.dark .cl-proof{--cl-accent:#eb8373}\n.cl-proof *,.cl-proof *::before,.cl-proof *::after{box-sizing:border-box}\n.cl-proof .cl-grid{display:grid;grid-template-columns:3fr 2fr;gap:16px}\n.cl-proof .cl-card{background:var(--cl-card);border:1px solid var(--cl-border);border-radius:16px;padding:28px}\n.cl-proof .cl-quote{margin:0;font-size:1.25rem;line-height:1.5}\n.cl-proof .cl-quote::before{content:\"\\201C\";display:block;font-size:2.5rem;line-height:1;color:var(--cl-accent);margin-bottom:4px}\n.cl-proof .cl-who{margin:16px 0 0;color:var(--cl-muted-fg);font-size:.9rem}\n.cl-proof .cl-gh{display:flex;flex-direction:column;justify-content:space-between;gap:16px;text-decoration:none;color:inherit}\n.cl-proof .cl-gh:hover{border-color:var(--cl-accent)}\n.cl-proof .cl-gh:focus-visible{outline:2px solid var(--cl-accent);outline-offset:2px}\n.cl-proof .cl-label{font-size:.8rem;letter-spacing:.08em;text-transform:uppercase;color:var(--cl-muted-fg);margin:0}\n.cl-proof .cl-stars{display:flex;align-items:baseline;gap:8px;margin:0;font-size:2.5rem;font-weight:600;line-height:1}\n.cl-proof .cl-stars svg{width:28px;height:28px;fill:var(--cl-accent);align-self:center}\n.cl-proof .cl-sub{margin:0;color:var(--cl-muted-fg);font-size:.95rem}\n.cl-proof .cl-link{color:var(--cl-accent);font-weight:500}\n@container (max-width:640px){.cl-proof .cl-grid{grid-template-columns:1fr}}\n</style>\n<div class=\"cl-grid\">\n  <figure class=\"cl-card\" style=\"margin:0\">\n    <blockquote class=\"cl-quote\">The Cloud plan has been a game-changer for my online school. Everything runs smoothly, and I don't have to worry about maintenance!</blockquote>\n    <figcaption class=\"cl-who\">Varsha S., Value Investing With Varsha</figcaption>\n  </figure>\n  <a class=\"cl-card cl-gh\" href=\"https://github.com/codelitdev/courselit\">\n    <p class=\"cl-label\">Open source since 2019</p>\n    <p class=\"cl-stars\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.53L12 17.5l-5.87 3.07 1.12-6.53L2.5 9.41l6.56-.95z\"/></svg><span data-cl-stars>1,299</span></p>\n    <p class=\"cl-sub\">stars on GitHub. <span class=\"cl-link\">See the code</span></p>\n  </a>\n</div>\n<script>\n(function () {\n  var ID = \"cl-proof\", READY = \"data-cl-ready\";\n  var cs = document.currentScript;\n  var rn = cs && cs.getRootNode ? cs.getRootNode() : null;\n  var el = rn && rn.getElementById ? rn.getElementById(ID) : null;\n  if (el && el.hasAttribute(READY)) el = null;\n  function search(root) {\n    var x = root.getElementById ? root.getElementById(ID) : root.querySelector(\"#\" + ID);\n    if (x && !x.hasAttribute(READY)) return x;\n    var all = root.querySelectorAll(\"*\");\n    for (var i = 0; i < all.length; i++) { if (all[i].shadowRoot) { x = search(all[i].shadowRoot); if (x) return x; } }\n    return null;\n  }\n  if (!el) el = search(document);\n  if (!el) return;\n  el.setAttribute(READY, \"\");\n  var out = el.querySelector(\"[data-cl-stars]\");\n  if (!out || !window.fetch) return;\n  fetch(\"https://api.github.com/repos/codelitdev/courselit\")\n    .then(function (r) { return r.ok ? r.json() : null; })\n    .then(function (d) { if (d && typeof d.stargazers_count === \"number\") out.textContent = d.stargazers_count.toLocaleString(\"en-US\"); })\n    .catch(function () {});\n})();\n</script>\n</div>\n"
      }
