    {
      "name": "faq",
      "settings": {
        "cssId": "faq",
        "title": "Questions, answered",
        "items": [
          {
            "question": "Does CourseLit take a cut of my sales?",
            "answer": "No. Learners pay through your own Stripe, Lemon Squeezy or Razorpay account, and CourseLit charges no transaction fee on any plan. Your payment provider's own fees still apply."
          },
          {
            "question": "What happens after the free trial?",
            "answer": "Your trial lasts 14 days and needs no card. To keep your school, choose Pro or Business. If you don't, your school becomes read-only for 15 days and is then deleted."
          },
          {
            "question": "Can I send emails during the trial?",
            "answer": "Your learners still get sign-in codes, receipts and access emails. Marketing emails, such as broadcasts and sequences, start once you're on a paid plan."
          },
          {
            "question": "Can I use my own domain?",
            "answer": "Yes. Add a domain such as learn.example.com in your website settings and create the two DNS records CourseLit shows you."
          },
          {
            "question": "Is self-hosting really free?",
            "answer": "Yes. The code is open source under AGPL-3.0 and self-hosted CourseLit has every feature. You run and pay for your own servers, database, storage and email service."
          }
        ]
      }
    },
