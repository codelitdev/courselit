{
  "$schema": "https://frontlit.app/schema/page.v1.json",
  "title": "CourseLit: open-source platform for online courses",
  "description": "Sell courses, digital downloads and community memberships from your own website, with email marketing built in. Open source. Use our cloud or self-host.",
  "layout": [
    {
      "name": "hero",
      "settings": {
        "verticalPadding": "py-24",
        "background": {
          "type": "gradient",
          "backgroundImage": "radial-gradient(ellipse 130% 90% at 50% 158%, var(--background) 0 68%, rgba(198,91,76,.55) 68.8%, rgba(198,91,76,.12) 70.5%, transparent 75%), radial-gradient(42% 55% at 12% 8%, rgba(198,91,76,.20), transparent 70%), radial-gradient(38% 50% at 90% 4%, rgba(207,123,38,.16), transparent 70%), url(\"data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%2722%27%20height%3D%2722%27%3E%3Ccircle%20cx%3D%273%27%20cy%3D%273%27%20r%3D%271.1%27%20fill%3D%27rgba%2838%2C29%2C22%2C.08%29%27%2F%3E%3C%2Fsvg%3E\")",
          "backgroundImageDark": "radial-gradient(ellipse 130% 90% at 50% 158%, var(--background) 0 68%, rgba(235,131,115,.6) 68.8%, rgba(235,131,115,.14) 70.5%, transparent 75%), radial-gradient(42% 55% at 12% 8%, rgba(235,131,115,.22), transparent 70%), radial-gradient(38% 50% at 90% 4%, rgba(230,160,92,.14), transparent 70%), url(\"data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%2722%27%20height%3D%2722%27%3E%3Ccircle%20cx%3D%273%27%20cy%3D%273%27%20r%3D%271.1%27%20fill%3D%27rgba%28235%2C231%2C226%2C.07%29%27%2F%3E%3C%2Fsvg%3E\")",
          "gradientBackgroundSize": "100% 100%, 100% 100%, 100% 100%, 22px 22px",
          "gradientBackgroundRepeat": "repeat"
        },
        "layout": "centered",
        "preTitle": "Open source. No fee on your sales.",
        "title": "Teach, sell and grow your audience *from your own website*",
        "description": "CourseLit brings your courses, digital downloads, community, email marketing and website together in one place. Run it on our cloud or host it yourself.",
        "buttonCaption": "Start free trial",
        "buttonAction": "https://app.courselit.app",
        "secondaryButtonCaption": "Explore features",
        "secondaryButtonAction": "/features",
        "smallPrint": "14-day free trial. No credit card needed."
      }
    },
    {
      "name": "embed",
      "settings": {
        "cssId": "how-it-works",
        "verticalPadding": "py-16",
        "contentType": "script",
        "content": "<div class=\"clf-wrap\" id=\"clf-flow\">\n<style>\n.clf-wrap{--clf-fg:var(--foreground,#261d16);--clf-muted:var(--muted-foreground,#5c544b);--clf-card:var(--card,#fefdfb);--clf-border:var(--border,#e2ddd5);--clf-soft:var(--muted,#eeebe5);--clf-accent:#b54c3d;--clf-accent-2:#c65b4c;--clf-tint:rgba(198,91,76,.10);--clf-ok:#2d8949;color:var(--clf-fg);font:inherit;font-family:\"fl-hanken-grotesk\",\"Hanken Grotesk\",ui-sans-serif,system-ui,sans-serif;container-type:inline-size}\n:host(.dark) .clf-wrap,.dark .clf-wrap{--clf-accent:#eb8373;--clf-accent-2:#eb8373;--clf-tint:rgba(235,131,115,.14);--clf-ok:#5fb37a}\n.clf-wrap *,.clf-wrap *::before,.clf-wrap *::after{box-sizing:border-box}\n.clf-wrap .clf-stage{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 150px minmax(0,1.15fr);align-items:center;gap:56px;max-width:1000px;margin:0 auto;padding:8px 0}\n.clf-wrap .clf-wires{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}\n.clf-wrap .clf-wire{fill:none;stroke:var(--clf-accent);stroke-opacity:.45;stroke-width:1.5;stroke-dasharray:4 6;animation:clf-flow 1.6s linear infinite}\n.clf-wrap .clf-col{display:flex;flex-direction:column;gap:14px;position:relative;z-index:1}\n.clf-wrap .clf-card{background:var(--clf-card);border:1px solid var(--clf-border);border-radius:16px;box-shadow:0 1px 2px rgba(38,29,22,.04),0 8px 24px -12px rgba(38,29,22,.18)}\n.clf-wrap .clf-src{display:flex;align-items:center;gap:12px;padding:12px 14px}\n.clf-wrap .clf-ico{flex:none;width:36px;height:36px;border-radius:10px;background:var(--clf-tint);color:var(--clf-accent);display:grid;place-items:center}\n.clf-wrap .clf-ico svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}\n.clf-wrap .clf-t{margin:0;font-weight:600;font-size:.95rem;line-height:1.3}\n.clf-wrap .clf-s{margin:2px 0 0;color:var(--clf-muted);font-size:.8rem;line-height:1.35}\n.clf-wrap .clf-hub{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center}\n.clf-wrap .clf-hub-tile{width:120px;height:120px;border-radius:30px;display:grid;place-items:center;background:linear-gradient(150deg,#d06a5a,#a8432f);box-shadow:0 0 0 8px var(--clf-tint),0 18px 40px -14px rgba(168,67,47,.6);animation:clf-breathe 4s ease-in-out infinite}\n.clf-wrap .clf-hub-tile svg{width:58px;height:58px}\n.clf-wrap .clf-hub-name{margin:0;font-weight:600;font-size:1rem}\n.clf-wrap .clf-url{margin:0;font-family:\"fl-spline-sans-mono\",\"Spline Sans Mono\",ui-monospace,monospace;font-size:.72rem;color:var(--clf-muted);background:var(--clf-soft);border-radius:999px;padding:4px 10px}\n.clf-wrap .clf-pay{padding:18px}\n.clf-wrap .clf-pay-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}\n.clf-wrap .clf-pay-head p{margin:0;font-weight:600;font-size:.95rem}\n.clf-wrap .clf-badge{font-size:.7rem;font-weight:600;color:var(--clf-ok);background:color-mix(in srgb,var(--clf-ok) 12%,transparent);border-radius:999px;padding:3px 9px;white-space:nowrap}\n.clf-wrap .clf-row{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-top:1px solid var(--clf-border);font-size:.85rem}\n.clf-wrap .clf-row span:first-child{color:var(--clf-muted)}\n.clf-wrap .clf-row b{font-weight:600}\n.clf-wrap .clf-row.clf-total b{color:var(--clf-accent);font-size:1rem}\n.clf-wrap .clf-providers{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}\n.clf-wrap .clf-chip{font-size:.72rem;border:1px solid var(--clf-border);border-radius:999px;padding:3px 9px;color:var(--clf-muted)}\n.clf-wrap .clf-chip.clf-on{border-color:var(--clf-accent);color:var(--clf-accent);background:var(--clf-tint)}\n.clf-wrap .clf-cap{margin:22px 0 0;text-align:center;color:var(--clf-muted);font-size:.78rem}\n@keyframes clf-flow{to{stroke-dashoffset:-20}}\n@keyframes clf-breathe{50%{box-shadow:0 0 0 14px var(--clf-tint),0 18px 40px -14px rgba(168,67,47,.6)}}\n@container (max-width:760px){\n.clf-wrap .clf-stage{grid-template-columns:1fr;gap:20px}\n.clf-wrap .clf-wires{display:none}\n.clf-wrap .clf-hub{order:-1}\n.clf-wrap .clf-hub-tile{width:88px;height:88px;border-radius:24px}\n.clf-wrap .clf-hub-tile svg{width:44px;height:44px}\n}\n@media (prefers-reduced-motion:reduce){.clf-wrap .clf-wire,.clf-wrap .clf-hub-tile{animation:none}}\n</style>\n<div class=\"clf-stage\">\n  <svg class=\"clf-wires\" aria-hidden=\"true\"><path class=\"clf-wire\" data-clf-wire=\"0\"/><path class=\"clf-wire\" data-clf-wire=\"1\"/><path class=\"clf-wire\" data-clf-wire=\"2\"/><path class=\"clf-wire\" data-clf-wire=\"3\"/></svg>\n  <div class=\"clf-col\">\n    <div class=\"clf-card clf-src\" data-clf-src>\n      <span class=\"clf-ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M22 10 12 5 2 10l10 5 10-5Z\"/><path d=\"M6 12v5c3 2 9 2 12 0v-5\"/></svg></span>\n      <div><p class=\"clf-t\">Courses</p><p class=\"clf-s\">Lessons, quizzes, certificates</p></div>\n    </div>\n    <div class=\"clf-card clf-src\" data-clf-src>\n      <span class=\"clf-ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3v12\"/><path d=\"m7 10 5 5 5-5\"/><path d=\"M5 21h14\"/></svg></span>\n      <div><p class=\"clf-t\">Digital downloads</p><p class=\"clf-s\">Ebooks, templates, lead magnets</p></div>\n    </div>\n    <div class=\"clf-card clf-src\" data-clf-src>\n      <span class=\"clf-ico\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"9\" cy=\"8\" r=\"3.5\"/><path d=\"M2.5 20c.8-3.4 3.4-5 6.5-5s5.7 1.6 6.5 5\"/><path d=\"M16 4.5a3.5 3.5 0 0 1 0 7\"/><path d=\"M18 15c2 .6 3.2 2.2 3.5 5\"/></svg></span>\n      <div><p class=\"clf-t\">Community</p><p class=\"clf-s\">Spaces, posts, paid plans</p></div>\n    </div>\n  </div>\n  <div class=\"clf-hub\" data-clf-hub>\n    <div class=\"clf-hub-tile\"><svg viewBox=\"0 0 64 64\" aria-hidden=\"true\"><g fill=\"rgba(255,255,255,.22)\" stroke=\"#fff\" stroke-width=\"2.6\" stroke-linejoin=\"round\"><path d=\"M32,10 L38,28 L32,34 L26,28 Z\"/><path d=\"M32,10 L38,28 L32,34 L26,28 Z\" transform=\"rotate(90 32 32)\"/><path d=\"M32,10 L38,28 L32,34 L26,28 Z\" transform=\"rotate(180 32 32)\"/><path d=\"M32,10 L38,28 L32,34 L26,28 Z\" transform=\"rotate(270 32 32)\"/></g></svg></div>\n    <p class=\"clf-hub-name\">Your school</p>\n    <p class=\"clf-url\">learn.yourdomain.com</p>\n  </div>\n  <div class=\"clf-col\">\n    <div class=\"clf-card clf-pay\" data-clf-pay>\n      <div class=\"clf-pay-head\"><p>New sale</p><span class=\"clf-badge\">Paid to your account</span></div>\n      <div class=\"clf-row\"><span>Watercolour basics</span><b>$49.00</b></div>\n      <div class=\"clf-row\"><span>CourseLit fee</span><b>$0.00</b></div>\n      <div class=\"clf-row clf-total\"><span>Goes to you</span><b>$49.00</b></div>\n      <div class=\"clf-providers\"><span class=\"clf-chip clf-on\">Stripe</span><span class=\"clf-chip\">Lemon Squeezy</span><span class=\"clf-chip\">Razorpay</span></div>\n    </div>\n  </div>\n</div>\n<p class=\"clf-cap\">Example sale. Your payment provider's own fees still apply.</p>\n<script>\n(function () {\n  var ID = \"clf-flow\", READY = \"data-clf-ready\";\n  var cs = document.currentScript;\n  var rn = cs && cs.getRootNode ? cs.getRootNode() : null;\n  var el = rn && rn.getElementById ? rn.getElementById(ID) : null;\n  if (el && el.hasAttribute(READY)) el = null;\n  function search(root) {\n    var x = root.getElementById ? root.getElementById(ID) : root.querySelector(\"#\" + ID);\n    if (x && !x.hasAttribute(READY)) return x;\n    var all = root.querySelectorAll(\"*\");\n    for (var i = 0; i < all.length; i++) { if (all[i].shadowRoot) { x = search(all[i].shadowRoot); if (x) return x; } }\n    return null;\n  }\n  if (!el) el = search(document);\n  if (!el) return;\n  el.setAttribute(READY, \"\");\n  var stage = el.querySelector(\".clf-stage\");\n  var wires = el.querySelectorAll(\"[data-clf-wire]\");\n  var srcs = el.querySelectorAll(\"[data-clf-src]\");\n  var hub = el.querySelector(\".clf-hub-tile\");\n  var pay = el.querySelector(\"[data-clf-pay]\");\n  function draw() {\n    var s = stage.getBoundingClientRect();\n    if (!s.width) return;\n    var h = hub.getBoundingClientRect();\n    var hx1 = h.left - s.left, hx2 = h.right - s.left, hy = h.top - s.top + h.height / 2;\n    for (var i = 0; i < srcs.length; i++) {\n      var r = srcs[i].getBoundingClientRect();\n      var x = r.right - s.left, y = r.top - s.top + r.height / 2, mx = (x + hx1) / 2;\n      wires[i].setAttribute(\"d\", \"M\" + x + \" \" + y + \" C\" + mx + \" \" + y + \" \" + mx + \" \" + hy + \" \" + hx1 + \" \" + hy);\n    }\n    var p = pay.getBoundingClientRect();\n    var px = p.left - s.left, py = p.top - s.top + p.height / 2, pm = (hx2 + px) / 2;\n    wires[3].setAttribute(\"d\", \"M\" + hx2 + \" \" + hy + \" C\" + pm + \" \" + hy + \" \" + pm + \" \" + py + \" \" + px + \" \" + py);\n  }\n  draw();\n  if (window.ResizeObserver) new ResizeObserver(draw).observe(stage);\n  else window.addEventListener(\"resize\", draw);\n})();\n</script>\n</div>\n"
      }
    },
    {
      "name": "embed",
      "settings": {
        "cssId": "works-with",
        "verticalPadding": "py-10",
        "contentType": "script",
        "content": "<div class=\"clt-wrap\" id=\"clt-tools\">\n<style>\n.clt-wrap{--clt-fg:var(--foreground,#261d16);--clt-muted:var(--muted-foreground,#5c544b);--clt-border:var(--border,#e2ddd5);color:var(--clt-fg);font:inherit;font-family:\"fl-hanken-grotesk\",\"Hanken Grotesk\",ui-sans-serif,system-ui,sans-serif;container-type:inline-size;text-align:center}\n.clt-wrap *,.clt-wrap *::before,.clt-wrap *::after{box-sizing:border-box}\n.clt-wrap .clt-lead{margin:0 0 18px;color:var(--clt-muted);font-size:.85rem}\n.clt-wrap .clt-row{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:10px 26px;margin:0 auto 14px;max-width:920px}\n.clt-wrap .clt-lbl{font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;color:var(--clt-muted);min-width:96px;text-align:right}\n.clt-wrap .clt-item{display:inline-flex;align-items:center;gap:7px;font-size:.95rem;font-weight:500;color:var(--clt-fg);opacity:.82}\n.clt-wrap .clt-item svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;opacity:.75}\n.clt-wrap .clt-note{margin:14px 0 0;color:var(--clt-muted);font-size:.72rem;opacity:.85}\n@container (max-width:640px){.clt-wrap .clt-lbl{width:100%;text-align:center;min-width:0}.clt-wrap .clt-row{gap:8px 18px}}\n</style>\n<p class=\"clt-lead\">Works with the payment providers and AI assistants you already use</p>\n<div class=\"clt-row\"><span class=\"clt-lbl\">Get paid with</span>\n  <span class=\"clt-item\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"2.5\" y=\"5\" width=\"19\" height=\"14\" rx=\"2.5\"/><path d=\"M2.5 10h19\"/></svg>Stripe</span>\n  <span class=\"clt-item\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3c5 0 9 3.6 9 8.5S17 21 12 21 3 16.4 3 11.5 7 3 12 3Z\"/><path d=\"M8.5 12.5c1.2 1.6 5.8 1.6 7 0\"/></svg>Lemon Squeezy</span>\n  <span class=\"clt-item\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M13 3 6 21h4l7-18Z\"/></svg>Razorpay</span>\n</div>\n<div class=\"clt-row\"><span class=\"clt-lbl\">Build with</span>\n  <span class=\"clt-item\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3v18M3 12h18M5.6 5.6l12.8 12.8M18.4 5.6 5.6 18.4\"/></svg>Claude</span>\n  <span class=\"clt-item\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"M8.5 12a3.5 3.5 0 0 1 7 0\"/></svg>ChatGPT</span>\n  <span class=\"clt-item\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m12 2.5 8.5 5v9L12 21.5l-8.5-5v-9Z\"/><path d=\"M12 12 3.5 7.5M12 12v9.5M12 12l8.5-4.5\"/></svg>Cursor</span>\n  <span class=\"clt-item\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m8 7-5 5 5 5M16 7l5 5-5 5\"/></svg>REST API</span>\n</div>\n<div class=\"clt-row\"><span class=\"clt-lbl\">Learner sign-in</span>\n  <span class=\"clt-item\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8.5\"/><circle cx=\"12\" cy=\"12\" r=\"3.5\"/></svg>Okta</span>\n  <span class=\"clt-item\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z\"/></svg>Microsoft Entra ID</span>\n  <span class=\"clt-item\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 12a8 8 0 1 1-2.3-5.7\"/><path d=\"M20 12h-8\"/></svg>Google Workspace</span>\n  <span class=\"clt-item\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"4\" y=\"10\" width=\"16\" height=\"11\" rx=\"2\"/><path d=\"M8 10V7a4 4 0 0 1 8 0v3\"/></svg>Keycloak</span>\n</div>\n<p class=\"clt-note\">Product names belong to their owners. Listed to show compatibility, not endorsement.</p>\n</div>\n"
      }
    },
