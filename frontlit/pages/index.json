        "cssId": "ai",
        "contentType": "script",
        "content": "<div class=\"clm-wrap\" id=\"clm-mcp\">\n<style>\n.clm-wrap{--clm-fg:var(--foreground,#261d16);--clm-muted:var(--muted-foreground,#5c544b);--clm-card:var(--card,#fefdfb);--clm-border:var(--border,#e2ddd5);--clm-soft:var(--muted,#eeebe5);--clm-panel:#efe6dd;--clm-accent:#b54c3d;--clm-tint:rgba(198,91,76,.10);--clm-ok:#2d8949;--clm-btn-fg:#fdfcf8;color:var(--clm-fg);font:inherit;font-family:\"fl-hanken-grotesk\",\"Hanken Grotesk\",ui-sans-serif,system-ui,sans-serif;container-type:inline-size}\n:host(.dark) .clm-wrap,.dark .clm-wrap{--clm-panel:#2a211b;--clm-accent:#eb8373;--clm-tint:rgba(235,131,115,.14);--clm-ok:#5fb37a;--clm-btn-fg:#250e0b}\n.clm-wrap *,.clm-wrap *::before,.clm-wrap *::after{box-sizing:border-box}\n.clm-wrap .clm-panel{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:40px;align-items:center;background:var(--clm-panel);border:1px solid var(--clm-border);border-radius:28px;padding:44px}\n.clm-wrap .clm-eye{margin:0 0 14px;font-family:\"fl-spline-sans-mono\",\"Spline Sans Mono\",ui-monospace,monospace;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--clm-accent)}\n.clm-wrap .clm-h{margin:0 0 14px;font-size:clamp(1.6rem,3.4cqw,2.3rem);line-height:1.15;font-weight:600;letter-spacing:-.02em}\n.clm-wrap .clm-p{margin:0 0 18px;color:var(--clm-muted);font-size:1rem;line-height:1.6}\n.clm-wrap .clm-list{list-style:none;margin:0 0 22px;padding:0;display:grid;gap:9px}\n.clm-wrap .clm-list li{display:flex;gap:10px;font-size:.93rem;line-height:1.45}\n.clm-wrap .clm-list svg{flex:none;width:16px;height:16px;margin-top:3px;fill:none;stroke:var(--clm-ok);stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}\n.clm-wrap .clm-url-l{margin:0 0 6px;font-size:.75rem;color:var(--clm-muted)}\n.clm-wrap .clm-url{display:flex;align-items:center;gap:8px;background:var(--clm-card);border:1px solid var(--clm-border);border-radius:12px;padding:6px 6px 6px 14px;max-width:420px}\n.clm-wrap .clm-url code{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:\"fl-spline-sans-mono\",\"Spline Sans Mono\",ui-monospace,monospace;font-size:.85rem}\n.clm-wrap .clm-copy{flex:none;border:0;border-radius:9px;background:var(--clm-fg);color:var(--clm-card);font:inherit;font-size:.8rem;font-weight:600;padding:8px 12px;cursor:pointer}\n.clm-wrap .clm-copy:focus-visible,.clm-wrap .clm-cta:focus-visible{outline:2px solid var(--clm-accent);outline-offset:2px}\n.clm-wrap .clm-works{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin:14px 0 24px;font-size:.8rem;color:var(--clm-muted)}\n.clm-wrap .clm-pill{border:1px solid var(--clm-border);background:var(--clm-card);border-radius:999px;padding:3px 10px;color:var(--clm-fg)}\n.clm-wrap .clm-ctas{display:flex;flex-wrap:wrap;gap:18px;align-items:center}\n.clm-wrap .clm-cta{display:inline-block;text-decoration:none;font-weight:600;font-size:.9rem;border-radius:12px;padding:11px 18px;background:var(--clm-accent);color:var(--clm-btn-fg)}\n.clm-wrap .clm-link{color:var(--clm-fg);font-weight:600;font-size:.9rem;text-decoration:underline;text-underline-offset:4px}\n.clm-wrap .clm-chat{background:var(--clm-card);border:1px solid var(--clm-border);border-radius:18px;box-shadow:0 24px 48px -24px rgba(38,29,22,.35);overflow:hidden}\n.clm-wrap .clm-bar{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--clm-border);font-size:.82rem;font-weight:600}\n.clm-wrap .clm-bar span:first-child{display:flex;align-items:center;gap:8px}\n.clm-wrap .clm-dot{width:20px;height:20px;border-radius:6px;background:var(--clm-fg);display:grid;place-items:center;color:var(--clm-card);font-size:.7rem}\n.clm-wrap .clm-live{font-size:.7rem;color:var(--clm-ok);background:color-mix(in srgb,var(--clm-ok) 12%,transparent);border-radius:999px;padding:3px 9px;display:flex;align-items:center;gap:5px}\n.clm-wrap .clm-live::before{content:\"\";width:6px;height:6px;border-radius:50%;background:var(--clm-ok)}\n.clm-wrap .clm-body{padding:16px;display:flex;flex-direction:column;gap:10px}\n.clm-wrap .clm-u{align-self:flex-end;max-width:85%;background:var(--clm-tint);border-radius:14px 14px 4px 14px;padding:9px 13px;font-size:.85rem;line-height:1.45}\n.clm-wrap .clm-tool{align-self:flex-start;font-family:\"fl-spline-sans-mono\",\"Spline Sans Mono\",ui-monospace,monospace;font-size:.7rem;color:var(--clm-muted);border:1px solid var(--clm-border);border-radius:8px;padding:3px 8px}\n.clm-wrap .clm-tool b{color:var(--clm-accent);font-weight:500}\n.clm-wrap .clm-res{border:1px solid var(--clm-border);border-radius:12px;padding:12px}\n.clm-wrap .clm-res-h{display:flex;justify-content:space-between;align-items:center;margin:0 0 8px;font-weight:600;font-size:.9rem}\n.clm-wrap .clm-tag{font-size:.68rem;font-weight:600;border-radius:999px;padding:2px 8px;background:var(--clm-soft);color:var(--clm-muted)}\n.clm-wrap .clm-sec{display:flex;justify-content:space-between;font-size:.8rem;padding:6px 0;border-top:1px solid var(--clm-border)}\n.clm-wrap .clm-sec span:last-child{color:var(--clm-muted)}\n.clm-wrap .clm-a{font-size:.85rem;line-height:1.5}\n.clm-wrap .clm-cap{margin:0;padding:10px 16px;border-top:1px solid var(--clm-border);font-size:.7rem;color:var(--clm-muted);text-align:center}\n@container (max-width:820px){.clm-wrap .clm-panel{grid-template-columns:1fr;padding:26px;gap:28px;border-radius:22px}}\n</style>\n<div class=\"clm-panel\">\n  <div>\n    <p class=\"clm-eye\">MCP server · connect your AI assistant</p>\n    <h2 class=\"clm-h\">Build your school from Claude, ChatGPT or Cursor</h2>\n    <p class=\"clm-p\">Add CourseLit to your assistant, sign in, and describe what you teach. It works with your permissions and asks before anything goes live.</p>\n    <ul class=\"clm-list\">\n      <li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m5 12 5 5 9-10\"/></svg><span><b>Draft courses</b> with sections, lessons and quizzes.</span></li>\n      <li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m5 12 5 5 9-10\"/></svg><span><b>Set up pricing</b> with free, one-time, subscription or instalment plans.</span></li>\n      <li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m5 12 5 5 9-10\"/></svg><span><b>Grant access</b> to learners and check their progress.</span></li>\n      <li><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m5 12 5 5 9-10\"/></svg><span><b>Edit your website</b> pages and blog posts as drafts.</span></li>\n    </ul>\n    <p class=\"clm-url-l\">MCP server address</p>\n    <div class=\"clm-url\"><code>https://api.courselit.app/mcp</code><button type=\"button\" class=\"clm-copy\" data-clm-copy=\"https://api.courselit.app/mcp\">Copy</button></div>\n    <div class=\"clm-works\">Works in <span class=\"clm-pill\">Claude</span><span class=\"clm-pill\">ChatGPT</span><span class=\"clm-pill\">Cursor</span> and other MCP clients</div>\n    <div class=\"clm-ctas\"><a class=\"clm-cta\" href=\"https://app.courselit.app\">Start free trial</a><a class=\"clm-link\" href=\"/docs/developers/mcp-server\">MCP setup guide →</a></div>\n  </div>\n  <div class=\"clm-chat\" aria-label=\"Example conversation with an AI assistant\">\n    <div class=\"clm-bar\"><span><span class=\"clm-dot\" aria-hidden=\"true\">✦</span>Your AI assistant</span><span class=\"clm-live\">CourseLit connected</span></div>\n    <div class=\"clm-body\">\n      <div class=\"clm-u\">Create a four-week watercolour course for beginners. Make the first lesson a free preview.</div>\n      <div class=\"clm-tool\">used <b>CourseLit</b> · create_product</div>\n      <div class=\"clm-tool\">used <b>CourseLit</b> · create_section ×4</div>\n      <div class=\"clm-res\">\n        <p class=\"clm-res-h\">Watercolour basics <span class=\"clm-tag\">Draft</span></p>\n        <div class=\"clm-sec\"><span>Week 1 · Materials and washes</span><span>3 lessons</span></div>\n        <div class=\"clm-sec\"><span>Week 2 · Colour mixing</span><span>3 lessons</span></div>\n        <div class=\"clm-sec\"><span>Week 3 · Layering</span><span>2 lessons</span></div>\n        <div class=\"clm-sec\"><span>Week 4 · Your first landscape</span><span>2 lessons</span></div>\n      </div>\n      <div class=\"clm-u\">Sell it for $49, one time.</div>\n      <div class=\"clm-tool\">used <b>CourseLit</b> · create_plan</div>\n      <div class=\"clm-a\">Done. The course is a draft with a $49 one-time plan. Shall I publish it, or do you want to review it first?</div>\n    </div>\n    <p class=\"clm-cap\">Example conversation with sample data.</p>\n  </div>\n</div>\n<script>\n(function () {\n  var ID = \"clm-mcp\", READY = \"data-clm-ready\";\n  var cs = document.currentScript;\n  var rn = cs && cs.getRootNode ? cs.getRootNode() : null;\n  var el = rn && rn.getElementById ? rn.getElementById(ID) : null;\n  if (el && el.hasAttribute(READY)) el = null;\n  function search(root) {\n    var x = root.getElementById ? root.getElementById(ID) : root.querySelector(\"#\" + ID);\n    if (x && !x.hasAttribute(READY)) return x;\n    var all = root.querySelectorAll(\"*\");\n    for (var i = 0; i < all.length; i++) { if (all[i].shadowRoot) { x = search(all[i].shadowRoot); if (x) return x; } }\n    return null;\n  }\n  if (!el) el = search(document);\n  if (!el) return;\n  el.setAttribute(READY, \"\");\n  var btn = el.querySelector(\"[data-clm-copy]\");\n  btn.addEventListener(\"click\", function () {\n    var text = btn.getAttribute(\"data-clm-copy\");\n    var done = function () { btn.textContent = \"Copied\"; setTimeout(function () { btn.textContent = \"Copy\"; }, 1600); };\n    if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, function () {});\n  });\n})();\n</script>\n</div>\n"
      }
    },
