{
  "name": "@courselit/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --timeout 60000 src",
    "lint": "biome lint .",
    "start": "bun src/main.ts",
    "worker": "bun src/worker.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "bun scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "generate:billing": "codelit-billing generate --config billing.config.ts",
    "generate:auth-schema": "bun scripts/generate-auth-schema.mjs",
    "check:billing-schema": "codelit-billing generate --check --config billing.config.ts",
    "check:auth-schema": "bun scripts/generate-auth-schema.mjs --check",
    "check:drift": "bun run check:billing-schema && bun run check:auth-schema",
    "migrate": "bun scripts/migrate.mjs",
    "migrate:domains": "bun scripts/import-domains.mjs",
    "migrate:products": "bun scripts/import-products.mjs",
    "migrate:payment-plans": "bun scripts/import-payment-plans.mjs",
    "migrate:communities": "bun scripts/import-communities.mjs",
    "migrate:learners": "bun scripts/import-learners.mjs",
    "migrate:notifications": "bun scripts/import-notifications.mjs",
    "pretest": "bun run check:auth-schema"
  },
  "dependencies": {
    "@better-auth/core": "1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.1",
    "@codelitdev/billing": "0.1.0-alpha.4",
    "@codelitdev/mcp-server-kit": "0.1.0-alpha.0",
    "@codelitdev/oauth-server-kit": "0.1.0-alpha.2",
    "@codelitdev/observability": "0.1.0-alpha.0",
    "@codelitdev/platform": "0.1.0-alpha.0",
    "@codelitdev/platform-conformance": "0.1.0-alpha.0",
    "@courselit/api-contract": "workspace:*",
    "@ts-rest/express": "3.52.1",
    "@ts-rest/open-api": "3.52.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.23.1",
    "better-auth": "1.7.2",
    "better-call": "1.4.0",
    "drizzle-orm": "0.45.2",
    "express": "4.21.2",
    "fflate": "0.4.9",
    "nodemailer": "^10.0.1",
    "pg": "8.23.0",
    "pino": "9.6.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/express": "4.17.25",
    "@types/node": "22.20.1",
    "@types/swagger-ui-express": "4.1.8",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "@types/bun": "1.4.1"
  }
}
