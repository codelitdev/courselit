# API runtime
PORT=4000
PUBLIC_API_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000
# Port the storefront is reached on when it is not 80/443 (local setups).
# STOREFRONT_PORT=3002
# Runtime domain for school subdomains. Set this to the domain serving storefronts;
# in development it defaults to *.localhost when omitted.
# PLATFORM_SITE_DOMAIN=example.com
NODE_ENV=development
DATABASE_URL=postgres://courselit:courselit@127.0.0.1:5432/courselit

# Generate local random values; AUTH_SECRET must be at least 32 characters.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
API_KEY_PEPPER=replace-with-a-random-pepper-at-least-32-characters
SEED=1

# MediaLit is injected at the API boundary; the API key never reaches browsers.
MEDIALIT_SERVER=https://api.medialit.cloud
MEDIALIT_APIKEY=replace-with-your-medialit-api-key
# Optional. Enables the Unsplash tab in the shared media uploader.
# UNSPLASH_ACCESS_KEY=replace-with-your-unsplash-access-key

# Custom domain verification. Schools point their domain at this target with
# a CNAME (or ALIAS/flattened CNAME at the apex) and prove ownership with a
# TXT record at `<record name>.<domain>`. Defaults: `sites.<PLATFORM_SITE_DOMAIN>`
# and `_courselit-verification`. Optionally pin apex A records.
# CUSTOM_DOMAIN_CNAME_TARGET=domains.example.com
# CUSTOM_DOMAIN_TXT_RECORD_NAME=_courselit-verification
# CUSTOM_DOMAIN_A_RECORDS=203.0.113.10,203.0.113.11

# SendLit email marketing and contacts integration.
# SENDLIT_SERVER is the SendLit API origin.
# SENDLIT_ORGANIZATION_API_KEY is an organization API key used for team provisioning.
# Set both values explicitly. For local development, use the server and
# BOOTSTRAP_TEAM_PROVISIONING_API_KEY configured by docker-compose.local.yml.
SENDLIT_SERVER=http://127.0.0.1:4101
# SENDLIT_ORGANIZATION_API_KEY=replace-with-sendlit-organization-api-key

# CourseLit-owned system email delivery. When configured, this platform team
# key takes precedence over SMTP and sends OTPs, team invitations, and other
# essential transactional mail through SendLit's POST /emails API.
# SENDLIT_PLATFORM_TEAM_API_KEY=replace-with-sendlit-platform-team-api-key

# SMTP fallback for system email when SendLit is not configured.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=

# Dedicated key for third-party integration secrets. AUTH_SECRET is the dev
# fallback, but production should use a separate value.
# INTEGRATIONS_ENCRYPTION_KEY=replace-with-a-dedicated-encryption-key

# Learner commerce payment settings are selected per school in the admin app.
# They are encrypted in the CourseLit database and are intentionally separate
# from @codelitdev/billing, which controls CourseLit platform billing.
# Supported school providers: Stripe, Lemon Squeezy, and Razorpay.

# Billing. cloud requires a paid plan to create a school; oss allows unlimited schools.
BILLING_MODE=cloud
# BILLING_MODE=oss
# Cloud catalog (ignored when BILLING_MODE=oss). Local/dev uses the Fake provider.
# BILLING_CHECKOUT_PROVIDER=fake
# BILLING_CATALOG_REVISION=1
# BILLING_CURRENCY=USD
# BILLING_PRO_MONTH_AMOUNT_MINOR=4900
# BILLING_PRO_YEAR_AMOUNT_MINOR=49000
# BILLING_BUSINESS_MONTH_AMOUNT_MINOR=19900
# BILLING_BUSINESS_YEAR_AMOUNT_MINOR=199000

# Optional observability integrations.
LOG_LEVEL=info
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://app.posthog.com
# OTLP_LOGS_ENDPOINT=
# OTLP_LOGS_AUTHORIZATION=
