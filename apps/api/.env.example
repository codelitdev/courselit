# API runtime
PORT=4000
PUBLIC_API_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000
# Public base URL payment providers deliver webhooks to. Defaults to
# WEB_ORIGIN/api; set it when that isn't reachable from the internet (e.g. a
# tunnel in development).
# PAYMENT_WEBHOOK_BASE_URL=https://your-tunnel.example/api
# Port the storefront is reached on when it is not 80/443 (local setups).
# STOREFRONT_PORT=3002
# Runtime domain for school subdomains. Set this to the domain serving storefronts;
# in development it defaults to *.localhost when omitted.
# PLATFORM_SITE_DOMAIN=example.com
NODE_ENV=development
DATABASE_URL=postgres://courselit:courselit@127.0.0.1:5432/courselit

# Generate local random values; AUTH_SECRET must be at least 32 characters.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
API_KEY_PEPPER=replace-with-a-random-pepper-at-least-32-characters
SEED=1

# MediaLit is injected at the API boundary; the API key never reaches browsers.
MEDIALIT_SERVER=https://api.medialit.cloud
MEDIALIT_APIKEY=replace-with-your-medialit-api-key
# Optional. Enables the Unsplash tab in the shared media uploader.
# UNSPLASH_ACCESS_KEY=replace-with-your-unsplash-access-key
# Optional. Enables GIF search in learner community posts.
# GIPHY_API_KEY=replace-with-your-giphy-api-key

# Custom domain verification. Schools point their domain at this target with
# a CNAME (or ALIAS/flattened CNAME at the apex) and prove ownership with a
# TXT record at `<record name>.<domain>`. Defaults: `sites.<PLATFORM_SITE_DOMAIN>`
# and `_courselit-verification`. Optionally pin apex A records.
# CUSTOM_DOMAIN_CNAME_TARGET=domains.example.com
# CUSTOM_DOMAIN_TXT_RECORD_NAME=_courselit-verification
# CUSTOM_DOMAIN_A_RECORDS=203.0.113.10,203.0.113.11

# SendLit email marketing and contacts integration.
# SENDLIT_SERVER is the SendLit API origin.
# SENDLIT_ORGANIZATION_API_KEY is an organization API key used for team provisioning.
# Set both values explicitly. For local development, use the server and
# BOOTSTRAP_TEAM_PROVISIONING_API_KEY configured by docker-compose.local.yml.
SENDLIT_SERVER=http://127.0.0.1:4101
# SENDLIT_ORGANIZATION_API_KEY=replace-with-sendlit-organization-api-key

# CourseLit-owned system email delivery. When configured, this platform team
# key takes precedence over SMTP and sends OTPs, team invitations, and other
# essential transactional mail through SendLit's POST /emails API.
# SENDLIT_PLATFORM_TEAM_API_KEY=replace-with-sendlit-platform-team-api-key

# SMTP fallback for system email when SendLit is not configured.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=

# Dedicated key for third-party integration secrets. AUTH_SECRET is the dev
# fallback, but production should use a separate value.
# INTEGRATIONS_ENCRYPTION_KEY=replace-with-a-dedicated-encryption-key

# Learner commerce payment settings are selected per school in the admin app.
# They are encrypted in the CourseLit database and are intentionally separate
# from @codelitdev/billing, which controls CourseLit platform billing.
# Supported school providers: Stripe, Lemon Squeezy, and Razorpay.

# Billing. cloud requires a paid plan to create a school; oss allows unlimited schools.
BILLING_MODE=cloud
# BILLING_MODE=oss
# Cloud billing (CourseLit's own Pro and Business plans). With no BILLING_PROVIDER,
# dev uses the Fake provider. BILLING_PROVIDER=dodo or lemonsqueezy makes everything
# below required: startup fails (e.g. BILLING_PRO_MONTH_AMOUNT_MINOR_required) instead
# of guessing a price. The amounts, currency and product ids must match the provider's
# products, or checkout stays off. The products must have no trial: the 14-day trial
# is CourseLit's own. Switching provider is a settings change: set BILLING_PROVIDER,
# the new product ids, and raise BILLING_CATALOG_REVISION (revisions are unique across
# providers). Keep the old provider's credentials set while it still has subscribers;
# its webhooks keep working.
# BILLING_PROVIDER=dodo
# BILLING_CATALOG_REVISION=1
# BILLING_CURRENCY=USD
# BILLING_PRO_MONTH_AMOUNT_MINOR=2900
# BILLING_PRO_YEAR_AMOUNT_MINOR=29000
# BILLING_BUSINESS_MONTH_AMOUNT_MINOR=7900
# BILLING_BUSINESS_YEAR_AMOUNT_MINOR=79000
# BILLING_PRO_MONTH_PRODUCT_ID=pdt_...      # Dodo product ids, or Lemon Squeezy variant ids
# BILLING_PRO_YEAR_PRODUCT_ID=pdt_...
# BILLING_BUSINESS_MONTH_PRODUCT_ID=pdt_...
# BILLING_BUSINESS_YEAR_PRODUCT_ID=pdt_...
# BILLING_DATA_ENCRYPTION_KEY=   # base64 of 32 bytes: openssl rand -base64 32. Keep it per environment.
# BILLING_DATA_ENCRYPTION_KEY_PREVIOUS=   # optional, comma-separated, during rotation
# Dodo:
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_ENVIRONMENT=test_mode               # or live_mode
# DODO_PAYMENTS_WEBHOOK_KEY_CURRENT=whsec_...       # endpoint: POST /webhooks/billing/dodo
# DODO_PAYMENTS_WEBHOOK_KEY_PREVIOUS=               # optional, during rotation
# DODO_BRAND_ID=brnd_...                            # optional; ignores other brands' webhooks
# Lemon Squeezy:
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=            # endpoint: POST /webhooks/billing/lemonsqueezy
# LEMONSQUEEZY_WEBHOOK_SECRET_PREVIOUS=   # optional, during rotation

# What each CourseLit plan allows on courselit.app (BILLING_MODE=cloud). All
# six are required in cloud mode: startup fails (e.g.
# PLAN_TRIAL_STORAGE_required) instead of reading a missing one as unlimited.
# A whole number or "unlimited"; storage also takes KB, MB, GB or TB.
# Not needed for BILLING_MODE=oss, which has no limits.
PLAN_PRO_MARKETING_EMAILS_MONTH=25000
PLAN_PRO_STORAGE=unlimited
PLAN_BUSINESS_MARKETING_EMAILS_MONTH=100000
PLAN_BUSINESS_STORAGE=unlimited
PLAN_TRIAL_MARKETING_EMAILS_MONTH=0
PLAN_TRIAL_STORAGE=500MB

# Cloud billing safety. Both are optional.
# BILLING_WEBHOOK_RATE_LIMIT_PER_MINUTE=300      # per process, for POST /webhooks/billing/:provider
# Production cloud billing refuses to start without BILLING_PROVIDER; set
# BILLING_MODE=oss for a deployment that has no hosted plans.

# Optional observability integrations.
LOG_LEVEL=info
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://app.posthog.com
# OTLP_LOGS_ENDPOINT=
# OTLP_LOGS_AUTHORIZATION=

# Which proxies' X-Forwarded-For hops the API trusts when resolving the client IP
# (rate limiting, API-key failure throttling, Better Auth). Express `trust proxy`
# syntax: a hop count (1), or comma-separated addresses/CIDRs/names from
# loopback, linklocal, uniquelocal. Default: private networks (cluster, local dev).
# Behind a public load balancer, list its addresses or set the exact hop count.
# TRUST_PROXY=loopback, linklocal, uniquelocal
