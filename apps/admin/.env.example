# URL of the product API used by the server-side BFF route.
API_URL=http://127.0.0.1:4000

# Learner app origin used by public page, product, and preview links. In local
# development, this defaults to http://localhost:3001 when omitted.
# NEXT_PUBLIC_LEARNER_ORIGIN=http://localhost:3001

# Optional request-time browser observability configuration.
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://app.posthog.com
# DEPLOY_ENV=development
