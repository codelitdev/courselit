{
    "name": "courselit",
    "private": true,
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "author": {
        "name": "The CodeLit Team",
        "email": "hi@codelit.dev"
    },
    "homepage": "",
    "repository": {
        "type": "git",
        "url": "https://github.com/codelitdev/courselit"
    },
    "license": "MIT",
    "scripts": {
        "lint": "eslint packages apps/docs apps/docs-new apps/web --quiet",
        "prettier": "prettier --write packages apps docs *.md",
        "build": "pnpm -r run build",
        "clean": "pnpm -r run clean",
        "ci:publish": "pnpm publish -r --no-git-checks",
        "dev": "pnpm --filter @courselit/web dev",
        "prepare": "husky",
        "release": "./release.sh",
        "test": "NODE_OPTIONS='--experimental-vm-modules' SUPPRESS_JEST_WARNINGS=1 jest",
        "test:watch": "NODE_OPTIONS='--experimental-vm-modules' SUPPRESS_JEST_WARNINGS=1 jest --watch",
        "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' SUPPRESS_JEST_WARNINGS=1 jest --coverage"
    },
    "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c",
    "devDependencies": {
        "@changesets/cli": "^2.29.7",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest": "^29.5.14",
        "eslint": "^9.12.0",
        "eslint-config-prettier": "^8.5.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-unused-imports": "^4.3.0",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "lint-staged": "^15.2.2",
        "mongodb-memory-server": "^10.1.4",
        "prettier": "^3.0.2",
        "tailwindcss": "^3.0.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=8.0.0"
    },
    "engineStrict": true,
    "lint-staged": {
        "*.{ts,tsx,js,mjs,css,md,json}": "prettier --write packages apps docs *.md",
        "*.{ts,tsx}": "eslint --quiet --cache --fix packages apps/docs apps/docs-new apps/web"
    },
    "pnpm": {
        "overrides": {
            "prosemirror-view": "^1.42.9",
            "@types/react": "18.3.7",
            "@types/react-dom": "18.3.0",
            "form-data": "^4.0.6",
            "@aws-sdk/core>fast-xml-parser": "^4.5.7",
            "@grpc/proto-loader>protobufjs": "^7.6.6",
            "axios": "^1.21.1",
            "fast-uri": "^3.1.9",
            "kysely": "0.28.17",
            "lodash": "4.18.1",
            "lodash-es": "4.18.1",
            "express>path-to-regexp": "0.1.13",
            "handlebars": "4.7.10",
            "proxy-addr": "2.0.8",
            "protobufjs": "^7.6.6",
            "follow-redirects": "^1.16.3",
            "@xmldom/xmldom@0.8": "^0.8.15",
            "minimatch@3": "^3.1.5",
            "minimatch@5": "^5.1.9",
            "minimatch@8": "^8.0.7",
            "minimatch@9": "^9.0.9",
            "brace-expansion@1": "^1.1.21",
            "brace-expansion@2": "^2.1.7",
            "brace-expansion@5": "^5.0.12",
            "js-yaml@3": "^3.15.2",
            "js-yaml@4": "^4.3.2",
            "glob@10": "^10.5.0",
            "flatted": "^3.4.4",
            "picomatch@2": "^2.3.2",
            "rollup@2": "^2.80.0",
            "rollup@3": "^3.30.0",
            "rollup@4": "^4.68.2",
            "@grpc/grpc-js": "^1.14.7",
            "linkify-it": "^5.0.2",
            "markdown-it": "^14.3.3",
            "ws@8": "^8.22.2",
            "ip-address": "^10.7.6",
            "browserslist": "^4.29.5",
            "immutable@3": "^3.8.4",
            "dompurify": "^3.4.17",
            "deepmerge-ts": "^8.0.2",
            "devalue": "^5.9.4",
            "source-map-js": "^1.2.2",
            "image-size": "^2.1.0",
            "body-parser@1": "^1.20.9",
            "nanoid@3": "^3.3.20",
            "nanoid@5": "^5.1.16",
            "postcss": "^8.5.32",
            "zod@4": "^4.6.7",
            "@opentelemetry/propagator-jaeger": "^2.12.1",
            "prosemirror-model": "^1.22.3"
        }
    }
}
