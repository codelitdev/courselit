{
  "name": "courselit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.1",
  "engines": {
    "bun": ">=1.4.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ],
  "overrides": {
    "esbuild": "0.28.2",
    "postcss": "8.5.28",
    "qs": "6.16.0",
    "ts-deepmerge": "8.0.0",
    "zod": "4.5.4"
  },
  "patchedDependencies": {
    "@anatine/zod-openapi@1.14.2": "patches/@anatine__zod-openapi@1.14.2.patch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.4.1",
    "puppeteer": "^25.11.0"
  },
  "scripts": {
    "dev:api": "bun --filter @courselit/api dev",
    "dev:worker": "bun --filter @courselit/api worker",
    "dev:admin": "bun --filter @courselit/admin dev",
    "dev:storefront": "bun --filter @courselit/storefront dev",
    "dev:docs": "bun --filter @courselit/docs dev",
    "lint": "bun run --workspaces --if-present lint",
    "format": "biome format --write .",
    "format:check": "biome ci --linter-enabled=false .",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "test": "bun run --workspaces --if-present test",
    "build": "bun run --workspaces --if-present build",
    "generate:check": "bun run --filter @courselit/api check:drift",
    "migrate": "bun apps/api/scripts/migrate.mjs"
  }
}
